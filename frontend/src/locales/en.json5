    mc59a938f: '{0} · {1}',
    // %s — %s
    m964803c2: '{0} — {1}',
    // %s …其余 %d 个
    m758aeeb3: '{0} … {1} more',
    // %s 不是合法的 http(s) 地址:%s
    ma74d0dc7: '{0} is not a valid http(s) address: {1}',
    // %s 不能为空值(null)
    m04302f53: '{0} cannot be null',
    // %s 不能包含 "..":%s
    md8fab176: '{0} must not contain "..": {1}',
    // %s 取值无效
    m425988b7: 'Invalid value for {0}',
    // %s 只能是 %s
    m319ea174: '{0} must be one of {1}',
    // %s 在 %s 上发起的审批超过时限仍未处理，请跟进
    mf54408da: 'The approval raised by {0} on {1} is overdue and still undecided; please follow up',
    // %s 必须在 %d ~ %d 之间,当前 %d
    mdf3152fe: '{0} must be between {1} and {2} (got {3})',
    // %s 必须是字符串
    m7bf1a6ab: '{0} must be a string',
    // %s 必须是布尔值
    meee1224b: '{0} must be a boolean',
    // %s 必须是整数
    m18fa3ca3: '{0} must be an integer',
    // %s 必须是绝对路径:%s
    m4086e12b: '{0} must be an absolute path: {1}',
    // %s 执行了你的工单 %s：%s
    mf979b864: '{0} executed your ticket {1}: {2}',
    // %s 撤回了你的工单：%s
    mb192e71e: '{0} withdrew your ticket: {1}',
    // %s 是服务账号,不能被授予查询权
    m5ffd0c77: '{0} is a service account and cannot be granted query access',
    // %s 未带 LIMIT,建议分批执行以免长事务锁表
    m2882f549: '{0} has no LIMIT; execute in batches to avoid long transactions holding locks',
    // %s 未带 WHERE 条件,将作用于全表
    mcea43d4d: '{0} has no WHERE clause and will affect the whole table',
    // %s 正被启用中的 API 凭据 %s 绑定,加上平台管理员会让这些凭据带着管理员权限工作。请先在「开放接口」停用或改绑这些凭据
    m63320da4: '{0} is bound to enabled API credentials {1}; adding the platform admin role would let those credentials act as an admin. Disable or rebind them under Open API first',
    // %s 的网关账号已停用,不能授权
    m6b7069aa: 'The gateway account of {0} is disabled; cannot grant access',
    // %s 第 %d 行第 %d 列 %s
    mfc648c5d: '{0} line {1} column {2} {3}',
    // %s 超出范围(%d ~ %d):%d
    m239545e0: '{0} is out of range ({1} ~ {2}): {3}',
    // %s 过长
    m0ae715a4: '{0} is too long',
    // %s 通过了你的命令：%s\n请到「审批」页找到这张工单并执行。
