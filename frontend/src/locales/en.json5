    // %w: 新密码至少 8 位
    m90179daa: '{0}: the new password must be at least 8 characters',
    // %w: 该账号没有本地口令
    meae83914: '{0}: this account has no local password',
    // %w: 请输入当前登录密码
    m1dbc4827: '{0}: please enter your current password',
    // ALTER TABLE %s DROP COLUMN %s 会丢弃列上的数据且不可回滚
    mc6083567: 'ALTER TABLE {0} DROP COLUMN {1} discards the column\'s data and cannot be rolled back',
