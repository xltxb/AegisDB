    ma0195bc6: 'ALTER TABLE {0} RENAME changes the live object name immediately; coordinate it with the application release',
    // ALTER TABLE %s 未指定 ALGORITHM/LOCK —— 默认行为不可见,大表上可能退化为全表拷贝并锁表
