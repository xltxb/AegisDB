  // 接口报错文案(apiMsg.<code>),由 go generate ./internal/apimsg 生成;en 只改值,不要手改键
  apiMsg: {
    //  secret=已修改
    m82a58f89: ' secret=changed',
    // %s %q 不是合法的 Oracle 标识符,拒绝拼入编译语句
    m345beea3: '{0} {1} is not a valid Oracle identifier; refusing to put it into a compile statement',
    // %s %s 已创建,但编译有 %d 个错误(对象为 INVALID):
    ma07316f0: '{0} {1} was created but has {2} compile errors (the object is INVALID):',
    // %s · %d 行 · %d 个分卷,可在「导出」页下载(解压口令在任务详情里)
