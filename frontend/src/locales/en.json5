    m5ce50944: '{0} contains an invalid IP: {1}',
    // %s 里有写错的网段:%s
    m8256a1a6: '{0} contains an invalid CIDR range: {1}',
    // %s 驳回了你的命令：%s
    m082ca5d0: '{0} rejected your command: {1}',
