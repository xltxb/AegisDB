  // Text the terminal PRINTS. Same mechanism as ruleText (see lib/ruleText.ts):
  // the server's Chinese string is the canonical record; this says the same thing
  // in the reader's language.
  //
  // A leading `·` marks a NOTICE rather than an execution result — the terminal
  // colours it yellow and appends no duration. Keep the prefix in every locale,
  // or a notice renders as a successful run.
  outText: {
    oscSplit: '· The index change on {table} goes through an online change; submit that statement on its own (it cannot be approved or run together with others)',
    oscPreflightFailed: '· The online-change pre-check failed: {err}',
    oscBlocked: '· The online-change pre-check on {table} did not pass; no ticket was raised:',
    oscStarted: '· The online change has started; follow its progress in the ticket',
    oscWindowStarted: '· No approval needed inside execution window “{window}”; the online change has started — follow its progress in ticket {no}',
    // row(s) 而不是 rows:消息语法的复数形式要靠 `|` 分隔,而 `|` 在这个仓库里是
    // 已知的雷(见 vite 的 strictMessage 预编译),为一句话把计数一路传进渲染器不划算。
    execAffected: 'Executed successfully · {n} row(s) affected',
    execFailed: '· Database execution failed: {err}',
    execCancelled: '· Cancelled — the target database may have run it, or part of it. Verify before assuming otherwise.',
    execTimeout: '· Timed out after {sec}s — the target database was told to stop the statement. It may have run in part; verify before assuming otherwise.',
    sqlplusSetIgnored: '· SET {option} is a SQL*Plus client command; the gateway does not send it, ignored',
    sqlplusRefused: '· {cmd} is a SQL*Plus command the gateway does not support',
    sqlplusIgnored: '· {cmd} is a SQL*Plus client command this channel does not handle; ignored',
    nothingToRun: '· Only comments or blanks: nothing to run',
    sqlplusExit: '· {cmd}: the script ends here',
    sqlplusWhenever: '· WHENEVER {text}: applies to the rest of this script',
    sqlplusVarDeclared: '· VARIABLE {name} {type} declared',
    sqlplusVarBad: '· VARIABLE {text}: unsupported type (NUMBER, BINARY_FLOAT/DOUBLE, CHAR/NCHAR, VARCHAR2/NVARCHAR2(n), CLOB/NCLOB are supported; REFCURSOR is not yet)',
    sqlplusPrintBad: '· PRINT: bind variable {name} is not declared',
    sqlplusPrintNone: '· PRINT: no bind variables declared yet',
    batchDoneFlow: 'Batch complete · {n} statements · {rows} row(s) affected · {inner}',
    flowExited: 'ended at EXIT (statement {pos})',
    flowContinued: '⚠ {f} statement(s) failed under WHENEVER SQLERROR CONTINUE: statement {failed}',
    flowExitedContinued: 'ended at EXIT (statement {pos}) · ⚠ {f} statement(s) failed under WHENEVER SQLERROR CONTINUE: statement {failed}',
    batchDone: 'Batch complete · {n} statements · {rows} row(s) affected',
    batchDoneZero: 'Batch complete · {n} statements · {rows} row(s) affected · ⚠ {z} of them affected 0 rows: statement {zero}',
    batchFailed: '· Stopped after {done}/{total} · statement {pos}: {inner}',
    maintenance: '· Target instance is in maintenance — operations are restricted',
    apWindowLive: '· Approved — the execution window is now in effect',
    apExportQueued: '· Approved — the export job has been queued',
    apPipeline: '· Approved — the release pipeline continues from here',
    apAwaitingExec: '· Approved — waiting for the initiator to execute',
  },
