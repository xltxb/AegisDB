# AegisDB — production environment (copy to `vela.env`, chmod 600).
# These override configs/config.yaml. NEVER commit the filled-in file.

# --- Required ---
# App / JWT signing secret. Must be strong and >= 32 chars, else the server
# refuses to start in prod. Generate with:  openssl rand -hex 32
VELA_JWT_SECRET=

# PostgreSQL DSN for the gateway's own store (libpq key=value or URL form).
# Required in prod: config.prod.yaml leaves postgres_dsn empty on purpose, and
# an empty DSN would make libpq silently connect to this host's default database.
# Spell out sslmode — the libpq default (`prefer`) falls back to PLAINTEXT without
# telling you, and this connection carries the credentials and the whole audit log.
# Keep the quotes, and keep them SINGLE. This file is read two ways — by systemd
# (EnvironmentFile) and by the shell (`set -a; . ./vela.env`) — and the two agree
# only inside single quotes:
#   * unquoted: a key=value DSN has spaces in it, so the shell takes only the
#     first word.
#   * double-quoted: systemd applies C-style escapes inside "", and the shell
#     expands $ inside "". Paste a real password containing `$` (pa$$w0rd) and
#     the shell swallows it while systemd keeps it — ONE file, TWO different
#     DSNs. It shows up as "systemd starts fine, but running `migrate` by hand
#     after `set -a; . ./vela.env` fails to authenticate", which is very hard
#     to track back to this line.
#   * single-quoted: neither side touches the contents. Literal, both ways.
# (A literal single quote cannot appear inside; if the password needs one,
# change the password or set VELA_PG_DSN from somewhere other than this file.)
VELA_PG_DSN='host=db.internal port=5432 user=vela password=CHANGE_ME dbname=vela_gateway sslmode=require'

# --- Optional ---
# Deployment profile. It does NOT pick a storage engine (that is always
# PostgreSQL) — it gates the demo seed, the JWT-strength check and CORS/SSRF.
# Usually set in config.yaml already.
APP_ENV=prod

# Dedicated at-rest encryption key for stored DB-connection passwords. Strongly
# recommended in prod: without it the key is derived from VELA_JWT_SECRET, so
# rotating the JWT secret would make every stored connection password
# undecryptable. Set once and DO NOT change it (rotating this key has the same
# effect). Generate with:  openssl rand -hex 32
# VELA_SECRET_KEY=

# Serve the bundled SPA (defaults to config.yaml's web_dir: web).
# VELA_WEB_DIR=web

# Terminate TLS on the gateway itself (otherwise put a reverse proxy in front).
# VELA_TLS_CERT=/opt/vela-gateway/tls/fullchain.pem
# VELA_TLS_KEY=/opt/vela-gateway/tls/privkey.pem

# Outbound audit-webhook Bearer token (sent as `Authorization: Bearer <secret>`;
# there is no HMAC signature). Only seeds the webhook row on first init —
# afterwards edit it under Settings › Webhook.
# VELA_WEBHOOK_SECRET=

# Allow outbound webhook / Lark / approval-service targets on private, loopback
# or link-local addresses. Blocked by default in prod (SSRF guard); set to
# true only if your receiver really lives inside the network.
# VELA_WEBHOOK_ALLOW_PRIVATE=false

# Admin bootstrap credentials — used only by `vela-gateway init`.
# VELA_ADMIN_EMAIL=admin@corp.io
# VELA_ADMIN_PASSWORD=
# VELA_ADMIN_NAME=Platform Admin
