# AegisDB — production environment (copy to `aegisdb.env`, chmod 600).
# These override configs/config.yaml. NEVER commit the filled-in file.

# --- Required ---
# App / JWT signing secret. Must be strong and >= 32 chars, else the server
# refuses to start in prod. Generate with:  openssl rand -hex 32
AEGISDB_JWT_SECRET=

# MySQL DSN for the gateway's own database.
AEGISDB_MYSQL_DSN=aegisdb:CHANGE_ME@tcp(127.0.0.1:3306)/aegisdb?charset=utf8mb4&parseTime=true&loc=Local
# 存储库搬到 PostgreSQL 之后(docs/上线部署SOP-存储库搬迁到PG.md)改用下面两行。切换只能写在这里,
# 写在 configs/config.yaml 里会被升级包覆盖。
#AEGISDB_DB_DRIVER=postgres
#AEGISDB_POSTGRES_DSN=host=127.0.0.1 port=5432 user=aegisdb password=CHANGE_ME dbname=aegisdb sslmode=disable

# --- Optional ---
# Deployment profile (prod => MySQL). Usually set in config.yaml already.
APP_ENV=prod

# Dedicated at-rest encryption key for stored DB-connection passwords. Strongly
# recommended in prod: without it the key is derived from AEGISDB_JWT_SECRET, so
# rotating the JWT secret would make every stored connection password
# undecryptable. Set once and DO NOT change it (rotating this key has the same
# effect). Generate with:  openssl rand -hex 32
# AEGISDB_SECRET_KEY=

# Serve the bundled SPA (defaults to config.yaml's web_dir: web).
# AEGISDB_WEB_DIR=web

# Terminate TLS on the gateway itself (otherwise put a reverse proxy in front).
# AEGISDB_TLS_CERT=/opt/aegisdb/tls/fullchain.pem
# AEGISDB_TLS_KEY=/opt/aegisdb/tls/privkey.pem

# Outbound webhook signing secret (audit webhook / Lark).
# AEGISDB_WEBHOOK_SECRET=

# Admin bootstrap credentials — used only by `aegisdb init`.
# AEGISDB_ADMIN_EMAIL=admin@corp.io
# AEGISDB_ADMIN_PASSWORD=
# AEGISDB_ADMIN_NAME=Platform Admin
