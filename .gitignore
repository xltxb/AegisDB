# ---- Backend (Go) ----
/backend/bin/
/backend/server
/backend/server.exe
*.test
*.out
vela-gateway.db
# 从 backend/ 起服务时,DSN 写相对路径的 sqlite 连接会就地建库(演示数据里的
# target.db 就是这么来的)。它们是被管理的**目标库**,装的是测试数据,和网关自己
# 那个 vela-gateway.db 一样不进仓库 —— 按目录整段忽略,免得每换一个库名就漏一次。
/backend/*.db
*.db-journal
*.db-wal
*.db-shm

# ---- Packaged build output (build.sh) ----
/dist/
/vela-gateway-*.tar.gz

# ---- Frontend (Node) ----
/frontend/node_modules/
/frontend/dist/
/frontend/dist.zip
/frontend/.vite/
*.local

# ---- Env / secrets ----
.env
.env.*
!.env.example
backend/configs/config.local.yaml

# ---- Editor / OS ----
.idea/
.vscode/
.agents/
.DS_Store
Thumbs.db

# ---- Local tooling / test artifacts ----
.claude/
/frontend/test-results/
/frontend/playwright-report/

# Test residue: export_default_test exercises the default (relative) export dir
/backend/internal/bootstrap/export/
# The same directory for a server run from backend/ — it holds real export
# archives. Encrypted, but they are extracts of whatever was queried, and the
# password travels beside them in the job row; nothing here belongs in a commit.
/backend/export/
/vela-web-*.zip
# Test residue: script-upload tests write under the package dir
/backend/internal/bootstrap/uploads/
# 同理,从 backend/ 起服务时上传的脚本落在这里 —— 是用户上传的真实 SQL,不进仓库
/backend/uploads/
# CodeGraph 本地索引 (SQLite),按机器生成,不进仓库
/.codegraph/
# ---- 被取代的 Vue 实现,留作对照与回退 ----
/frontend-vue/node_modules/
/frontend-vue/dist/
