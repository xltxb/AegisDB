# ---- Backend (Go) ----
/backend/bin/
/backend/server
/backend/server.exe
*.test
*.out
# 网关自己的库不再是 sqlite(它只住在 PostgreSQL 里),但旧工作区里还留着这个文件,
# 所以这条模式保留 —— 删掉它只会让一堆机器上突然冒出一个未跟踪文件。
vela-gateway.db
# DSN 写相对路径的 sqlite 连接从 backend/ 起服务时会就地建库(演示数据里的
# target.db 就是这么来的)。它们是被管理的**目标库**,装的是测试数据,同样不进仓库
# —— 按目录整段忽略,免得每换一个库名就漏一次。
/backend/*.db
*.db-journal
*.db-wal
*.db-shm

# ---- Packaged build output (build.sh) ----
/dist/
/vela-gateway-*.tar.gz

# ---- Frontend (Node) ----
/frontend/node_modules/
/frontend/dist/
/frontend/dist.zip
/frontend/.vite/
*.local

# ---- Env / secrets ----
.env
.env.*
!.env.example
backend/configs/config.local.yaml

# ---- Editor / OS ----
.idea/
.vscode/
.agents/
.DS_Store
Thumbs.db

# ---- Local tooling / test artifacts ----
# .claude/ 是本机的 Claude Code 工作区(权限配置、skills),不进仓库。
.claude/
# .scratch/ 放 PRD 与工单草稿,属于本地工作记录,不进仓库。
.scratch/
/frontend/test-results/
/frontend/playwright-report/

# Test residue: export_default_test exercises the default (relative) export dir
/backend/internal/bootstrap/export/
# The same directory for a server run from backend/ — it holds real export
# archives. Encrypted, but they are extracts of whatever was queried, and the
# password travels beside them in the job row; nothing here belongs in a commit.
/backend/export/
/vela-web-*.zip
# Test residue: script-upload tests write under the package dir
/backend/internal/bootstrap/uploads/
# 同理,从 backend/ 起服务时上传的脚本落在这里 —— 是用户上传的真实 SQL,不进仓库
/backend/uploads/
# CodeGraph 本地索引 (SQLite),按机器生成,不进仓库
/.codegraph/
